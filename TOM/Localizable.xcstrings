{
  "sourceLanguage": "en",
  "strings": {
    "About TOM": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über TOM"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de TOM"
          }
        }
      }
    },
    "Accessibility permission is missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Berechtigung fehlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el permiso de Accesibilidad."
          }
        }
      }
    },
    "Active": {
      "comment": "Switch that turns a simulation on or off; kept very short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo"
          }
        }
      }
    },
    "Active until %@": {
      "comment": "Footer under Keep Mac Awake; %@ is a time, or date and time.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv bis %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo hasta %@"
          }
        }
      }
    },
    "Allow TOM under Login Items in System Settings.": {
      "comment": "Shown when macOS requires the user to approve the login item.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Systemeinstellungen unter „Anmeldeobjekte“ erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítelo en Ajustes del Sistema, en «Ítems de inicio»."
          }
        }
      }
    },
    "Apply": {
      "comment": "Button on the Setup page that saves the changes and returns.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar"
          }
        }
      }
    },
    "Arrow Keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeiltasten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flechas"
          }
        }
      }
    },
    "Battery protection": {
      "comment": "Setup switch; off by default.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkuschutz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección de batería"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Button on the Setup page that discards the changes and returns.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Click starts in %lld s – position the pointer now …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick startet in %lld s – Zeiger jetzt positionieren …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clic empieza en %lld s: coloca el puntero …"
          }
        }
      }
    },
    "Clicks happen wherever the pointer is. %@ stops all simulations immediately, at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geklickt wird dort, wo der Zeiger gerade steht. %@ beendet alle Simulationen jederzeit sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hace clic donde esté el puntero. %@ detiene todas las simulaciones al instante."
          }
        }
      }
    },
    "Command": {
      "comment": "Modifier key label.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando"
          }
        }
      }
    },
    "Control": {
      "comment": "Modifier key label.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control"
          }
        }
      }
    },
    "Delete": {
      "comment": "Key label for the backspace key.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprimir"
          }
        }
      }
    },
    "Duration": {
      "comment": "Timer option: stays on for a number of hours and minutes.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración"
          }
        }
      }
    },
    "Emergency stop active: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Not-Aus aktiv: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada de emergencia: %@"
          }
        }
      }
    },
    "Ends after": {
      "comment": "Row label before the hours and minutes fields.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endet nach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina tras"
          }
        }
      }
    },
    "Ends at": {
      "comment": "Row label before the time-of-day field.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endet um"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a las"
          }
        }
      }
    },
    "Esc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        }
      }
    },
    "Function Keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionstasten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas de función"
          }
        }
      }
    },
    "GNU General Public License v3": {
      "comment": "Window title of the license viewer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU General Public License v3"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU General Public License v3"
          }
        }
      }
    },
    "Hide TOM from the Dock": {
      "comment": "Switch; only available while the menu bar icon is shown.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM im Dock ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar TOM del Dock"
          }
        }
      }
    },
    "Hold": {
      "comment": "Mode: key or mouse button stays pressed until switched off; kept short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado"
          }
        }
      }
    },
    "Hold & Pause": {
      "comment": "Mode: alternately hold for a set time, then release for a set time.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten & Pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener y pausa"
          }
        }
      }
    },
    "Hold Time": {
      "comment": "Row label: how many seconds the key or button stays pressed per cycle.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltedauer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo pulsado"
          }
        }
      }
    },
    "Interval": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervall"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo"
          }
        }
      }
    },
    "Keep Mac Awake": {
      "comment": "Section header.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wachhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac activo"
          }
        }
      }
    },
    "Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla"
          }
        }
      }
    },
    "Key press starts in %lld s – bring the target window to the front now …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastendruck startet in %lld s – Zielfenster jetzt nach vorne holen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulsación empieza en %lld s: pon la ventana en primer plano …"
          }
        }
      }
    },
    "Launch TOM at login": {
      "comment": "Switch: start TOM automatically when the user logs in.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM beim Anmelden starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir TOM al iniciar sesión"
          }
        }
      }
    },
    "Left": {
      "comment": "Mouse button.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Izquierdo"
          }
        }
      }
    },
    "Letters": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras"
          }
        }
      }
    },
    "Mode": {
      "comment": "Picker label for how a key or mouse button is pressed.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo"
          }
        }
      }
    },
    "Mouse Button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maustaste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botón del ratón"
          }
        }
      }
    },
    "Mouse movement starts in %lld s …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mausbewegung startet in %lld s …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento empieza en %lld s …"
          }
        }
      }
    },
    "Numbers": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números"
          }
        }
      }
    },
    "On battery power, TOM switches off everything it is doing once the charge drops to this level. Nothing happens while the Mac is charging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Akkubetrieb schaltet TOM alles ab, was es gerade tut, sobald der Ladestand auf diesen Wert fällt. Während der Mac lädt, passiert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con batería, TOM desactiva todo lo que esté haciendo cuando la carga baje a este nivel. Mientras el Mac se carga, no ocurre nada."
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes del Sistema"
          }
        }
      }
    },
    "Option": {
      "comment": "Modifier key label.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opción"
          }
        }
      }
    },
    "Pause": {
      "comment": "Row label: how many seconds the key or button stays released per cycle.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa"
          }
        }
      }
    },
    "Press": {
      "comment": "Mode: short press at a fixed interval; kept very short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar"
          }
        }
      }
    },
    "Prevents the system from going to sleep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand des Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que el sistema entre en reposo."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        }
      }
    },
    "Return": {
      "comment": "Key label for the return/enter key.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorno"
          }
        }
      }
    },
    "Right": {
      "comment": "Mouse button.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derecho"
          }
        }

        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla"
          }
        }
      }
    },
    "Key press starts in %lld s – bring the target window to the front now …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastendruck startet in %lld s – Zielfenster jetzt nach vorne holen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulsación empieza en %lld s: pon la ventana en primer plano …"

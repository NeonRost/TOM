{
  "sourceLanguage": "en",
  "strings": {
    "About TOM": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über TOM"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de TOM"
          }
        }
      }
    },
    "Accessibility permission is missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Berechtigung fehlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el permiso de Accesibilidad."
          }
        }
      }
    },
    "Active": {
      "comment": "Switch that turns a simulation on or off; kept very short.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apariencia"
          }
        }
      }
    },
    "Arrow Keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeiltasten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flechas"
          }
        }
      }
    },
    "Click starts in %lld s – position the pointer now …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick startet in %lld s – Zeiger jetzt positionieren …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clic empieza en %lld s: coloca el puntero …"
          }
        }
      }
    },
    "Clicks happen wherever the pointer is. %@ stops mouse click and mouse movement immediately, at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geklickt wird dort, wo der Zeiger gerade steht. %@ beendet Mausklick und Mausbewegung jederzeit sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hace clic donde esté el puntero. %@ detiene el clic y el movimiento al instante."
          }
        }
      }
    },
    "Command": {
      "comment": "Modifier key label.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando"
          }
        }
      }
    },
    "Control": {
      "comment": "Modifier key label.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control"
          }
        }
      }
    },
    "Delete": {
      "comment": "Key label for the backspace key.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprimir"
          }
        }
      }
    },
    "Emergency stop active: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Not-Aus aktiv: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada de emergencia: %@"
          }
        }
      }
    },
    "Esc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc"
          }
        }

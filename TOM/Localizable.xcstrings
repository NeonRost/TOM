    "Show License": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenztext anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver la licencia"
          }
        }
      }
    },
    "Show TOM in the menu bar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM in der Menüleiste anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar TOM en la barra de menús"
          }
        }
      }
    },

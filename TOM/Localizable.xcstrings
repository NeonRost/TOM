    "Simulate Mouse Click": {
      "comment": "Section header.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mausklick simulieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simular clic del ratón"
          }
        }

    "Special Keys": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondertasten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas especiales"
          }
        }

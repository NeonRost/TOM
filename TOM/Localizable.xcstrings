    "TOM comes with absolutely no warranty. Redistribution and modification are permitted under the terms of the GNU GPL v3.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM wird ohne jede Gewährleistung bereitgestellt. Weitergabe und Veränderung sind unter den Bedingungen der GNU GPL v3 gestattet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM se ofrece sin ninguna garantía. Se permite su redistribución y modificación según los términos de la GNU GPL v3."
          }
        }
      }
    },
    "TOM is keeping the Mac awake": {
      "comment": "Reason shown by the system for the power assertion (pmset -g assertions).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM hält den Rechner wach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM mantiene el Mac activo"
          }
        }
      }
    },
    "Tab": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab"
          }
        }
      }
    },
    "The LICENSE file was not found in the app bundle. The license text is available at https://www.gnu.org/licenses/gpl-3.0.txt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die LICENSE-Datei wurde im App-Bundle nicht gefunden. Der Lizenztext ist unter https://www.gnu.org/licenses/gpl-3.0.txt abrufbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el archivo LICENSE en la app. El texto de la licencia está disponible en https://www.gnu.org/licenses/gpl-3.0.txt"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %@"
          }
        }
      }
    },

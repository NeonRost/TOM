      "comment": "Section header.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wachhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac activo"
          }
        }
      }

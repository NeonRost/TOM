    "Prevents the system from going to sleep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand des Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que el sistema entre en reposo."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        }
      }
    },
